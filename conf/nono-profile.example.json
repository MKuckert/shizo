{
  "meta": {
    "name": "shizo-example",
    "version": "2",
    "description": "Deployment example for wrapping a shizo-gated agent. See README.md#example-sandbox-profile before use."
  },
  "workdir": {
    "access": "read"
  },
  "filesystem": {
    "read": [
      "~/.shizo",
      "~/.shizo/attestations",
      "~/.shizo/engine",
      "~/.shizo/global",
      "<AGENT_WORKDIR>"
    ],
    "allow": [
      "~/.shizo/logs",
      "<AGENT_WORKDIR>/src",
      "<AGENT_WORKDIR>/docs"
    ],
    "allow_file": ["<AGENT_WORKDIR>/README.md"]
  },
  "network": {
    "block": true
  },
  "environment": {
    "allow_vars": ["HOME", "PATH", "SHELL", "TERM", "LANG"]
  }
}
