{
  "meta": {
    "name": "shizo-example",
    "version": "1",
    "description": "Deployment example for wrapping a shizo-gated agent. See README.md#example-sandbox-profile before use."
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": [
      "~/.shizo",
      "~/.shizo/attestations",
      "~/.shizo/engine",
      "~/.shizo/global"
    ],
    "allow": ["~/.shizo/logs", "<AGENT_WORKDIR>"]
  },
  "network": {
    "block": true
  },
  "environment": {
    "allow_vars": ["HOME", "PATH", "SHELL", "TERM", "LANG"]
  }
}
