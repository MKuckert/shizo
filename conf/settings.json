{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git config --get:*)",
      "Bash(git config --get-regexp:*)",
      "Bash(git config --list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git * --hard*)",
      "Bash(git clone *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git submodule add *)",
      "Bash(git submodule update)",
      "Bash(git hook *)",
      "Bash(git credential *)",
      "Bash(git clean * -f*)",
      "Bash(git checkout .)",
      "Bash(git * -c *)",
      "Bash(git * --ext-diff*)",

      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(rg * --pre*)",
      "Bash(tar * --checkpoint-action*)",
      "Bash(tar * --to-command*)",
      "Bash(tar * --use-compress-program*)",
      "Bash(tar * -I *)",
      "Bash(sort * --compress-program*)",
      "Bash(gsort * --compress-program*)",
      "Bash(split * --filter*)",
      "Bash(gsplit * --filter*)",
      "Bash(install * --strip-program*)",
      "Bash(ginstall * --strip-program*)",

      "Bash(curl * -d *)",
      "Bash(curl * --data*)",
      "Bash(curl * -F *)",
      "Bash(curl * --upload-file*)",
      "Bash(wget * --post-data*)",

      "Bash(ln *)",
      "Bash(rm * -rf*)",
      "Bash(dd *)",
      "Bash(mkfs *)",

      "Bash(eval:*)",
      "Bash(exec:*)",
      "Bash(source:*)",
      "Bash(env:*)",
      "Bash(xargs:*)",
      "Bash(sudo:*)",

      "Bash(ssh:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(ruby:*)",
      "Bash(perl:*)",
      "Bash(swift:*)",
      "Bash(osascript:*)",
      "Bash(expect:*)",
      "Bash(tclsh:*)",
      "Bash(wish:*)",
      "Bash(m4:*)",
      "Bash(php:*)",
      "Bash(sh:*)",
      "Bash(zsh:*)",
      "Bash(bash:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(make:*)"
    ]
  }
}
