{
  "name": "shizo",
  "displayName": "shizo rules",
  "description": "Syntax highlighting for shizo rule files",
  "author": {
    "name": "Martin Kuckert"
  },
  "publisher": "mkuckert",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "shizo",
        "aliases": [
          "shizo rules"
        ],
        "filenames": [
          ".shizo",
          "global-rules.starter"
        ],
        "filenamePatterns": [
          "**/.shizo/global/rules"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "shizo",
        "scopeName": "source.shizo",
        "path": "./shizo.tmLanguage.json"
      }
    ]
  }
}
