{
  "permissions": {
    "allow": ["Bash(nono why *)", "Bash(make *)", "Bash(go *)"],
    "deny": ["Bash(git push *)"]
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.shizo/engine/shizo.sh"
          }
        ]
      }
    ]
  }
}
