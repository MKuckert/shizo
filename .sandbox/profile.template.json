{
  "$schema": "/Users/mkuckert/.config/nono/nono-profile.schema.json",
  "extends": ["nolabs-ai/claude"],
  "meta": {
    "name": "bash-gate-claude",
    "version": "2"
  },
  "groups": {
    "include": ["go_runtime", "go_runtime_macos"]
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "~/.npm",
      "~/.go",
      "~/.claude-bash-rules/logs",
      "~/repos/bash-gate"
    ],
    "deny": ["~/.gitconfig"],
    "read_file": [
      "~/.gitconfig-private",
      "~/.gitconfig-work",
      "~/.gitconfig-agents",
      "~/.gitignore",
      "~/.bashrc",
      "/opt/homebrew/bin/go"
    ],
    "read": ["~/.CFUserTextEncoding", "~/.claude-bash-rules"],
    "bypass_protection": ["~/.bashrc"]
  },
  "network": {
    "allow_domain": ["localhost", "proxy.golang.org", "sum.golang.org"],
    "open_port_range": [[11400, 11500]]
  },
  "environment": {
    "allow_vars": [
      "HOME",
      "SHELL",
      "TERM",
      "PATH",
      "LSCOLORS",
      "LS_COLORS",
      "LC_ALL",
      "LANG",
      "PWD",
      "USER",
      "EDITOR"
    ],
    "set_vars": {
      "GIT_CONFIG_GLOBAL": "~/.gitconfig-agents",
      "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
      "CLAUDE_CODE_HIDE_CWD": "1",
      "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5",
      "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
      "CLAUDE_CODE_MAX_TURNS": "200",
      "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
      "CLAUDE_CODE_RESUME_INTERRUPTED_TURN": "0",
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
      "DISABLE_AUTO_COMPACT": "1",
      "DISABLE_FEEDBACK_COMMAND": "1",
      "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
      "DISABLE_UPGRADE_COMMAND": "1",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8",
      "DO_NOT_TRACK": "1",
      "GOPATH": "~/.go"
    }
  }
}
