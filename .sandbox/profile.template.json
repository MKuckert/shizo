{
  "$schema": "/Users/mkuckert/.config/nono/nono-profile.schema.json",
  "extends": ["nolabs-ai/claude", "nolabs-ai/opencode"],
  "meta": {
    "name": "shizo-claude",
    "version": "14"
  },
  "groups": {
    "include": ["go_runtime", "go_runtime_macos"]
  },
  "workdir": {
    "access": "read"
  },
  "filesystem": {
    "allow": [
      "~/.npm",
      "~/.go",
      "~/.shizo/logs",
      "$WORKDIR/cmd",
      "$WORKDIR/conf",
      "$WORKDIR/dist",
      "$WORKDIR/docs",
      "$WORKDIR/plans",
      "$WORKDIR/public",
      "$WORKDIR/site",
      "$WORKDIR/src",
      "$WORKDIR/tools"
    ],
    "allow_file": [
      "$WORKDIR/CLAUDE.md",
      "$WORKDIR/Makefile",
      "$WORKDIR/README.md",
      "$WORKDIR/.mcp.json"
    ],
    "deny": ["~/.gitconfig"],
    "read_file": [
      "~/.gitconfig-private",
      "~/.gitconfig-work",
      "~/.gitconfig-agents",
      "~/.gitignore",
      "~/.bashrc",
      "~/.bashprofile",
      "/opt/homebrew/bin/go"
    ],
    "read": [
      "~/repos/shizo",
      "~/.CFUserTextEncoding",
      "~/.shizo",
      "~/.shizo/attestations",
      "~/.shizo/engine",
      "~/.shizo/global"
    ],
    "bypass_protection": ["~/.bashrc", "~/.bashprofile"]
  },
  "network": {
    "allow_domain": [
      "localhost",
      "proxy.golang.org",
      "sum.golang.org",
      "github.com"
    ],
    "open_port_range": [[11400, 11500]]
  },
  "environment": {
    "allow_vars": [
      "HOME",
      "SHELL",
      "TERM",
      "PATH",
      "LSCOLORS",
      "LS_COLORS",
      "LC_ALL",
      "LANG",
      "PWD",
      "USER",
      "EDITOR",
      "OMLX_PORT",
      "OMLX_API_KEY",
      "APFEL_PORT",
      "APFEL_TOKEN"
    ],
    "set_vars": {
      "GIT_CONFIG_GLOBAL": "~/.gitconfig-agents",
      "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
      "CLAUDE_CODE_HIDE_CWD": "1",
      "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5",
      "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
      "CLAUDE_CODE_MAX_TURNS": "200",
      "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "0",
      "CLAUDE_CODE_RESUME_INTERRUPTED_TURN": "0",
      "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
      "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
      "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
      "CLAUDE_CODE_THRIFTY_SONIC": "0",
      "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "0",
      "DISABLE_AUTO_COMPACT": "1",
      "DISABLE_FEEDBACK_COMMAND": "1",
      "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
      "DISABLE_UPGRADE_COMMAND": "1",
      "OPENCODE_ENABLE_EXA": "1",
      "OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS": "1",
      "DO_NOT_TRACK": "1",
      "GOPATH": "~/.go"
    }
  }
}
