{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-cost-guard", "opencode-plugin-statusbar"],
  "default_agent": "Buddy",
  "agent": {
    "plan": {
      "disable": true,
    },
    "build": {
      "disable": true,
    },
    "explore": {
      "model": "github-copilot/claude-sonnet-5",
    },
    "general": {
      "model": "github-copilot/claude-sonnet-5",
    },
  },
  "permission": {
    "external_directory": {
      "/tmp": "allow",
    },
  },
}
